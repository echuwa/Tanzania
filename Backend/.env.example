# ═══════════════════════════════════════════════════════════════
#  MUUNGANO WETU AI — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit your actual .env file to GitHub!
# ═══════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── DATABASE (PostgreSQL) ───────────────────────────────────────
# Get this from Render, Supabase, or your hosting provider
DATABASE_URL=postgresql://username:password@host:5432/database_name

# ── JWT (Authentication) ────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_64_character_string

# ── WHATSAPP (Meta Business Cloud API) ─────────────────────────
# Get from: Meta Developer Dashboard → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ── TELEGRAM ───────────────────────────────────────────────────
# Get from: @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxx

# ── SMS — Africa's Talking ─────────────────────────────────────
# Get from: africastalking.com → Your Account → API Key
AT_USERNAME=your_africastalking_username
AT_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxx

# ── AI SERVICES ────────────────────────────────────────────────
# Groq (Primary AI) — Get from: console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini (Fallback AI) — Get from: aistudio.google.com
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── EMAIL (Password Reset & Welcome Emails) ─────────────────────
# Gmail Setup: Google Account → Security → 2FA → App Passwords → Generate
# App Password is 16 chars like: xxxx xxxx xxxx xxxx
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── FRONTEND URL ────────────────────────────────────────────────
# Your deployed admin dashboard URL (no trailing slash)
FRONTEND_URL=https://your-dashboard-domain.com

# ── SUPER ADMIN (Optional — for automated deployment only) ──────
# If set, the createSuperAdmin.js script runs non-interactively
# SUPER_ADMIN_NAME=John Doe
# SUPER_ADMIN_EMAIL=admin@yourdomain.com
# SUPER_ADMIN_PASSWORD=SecurePassword123!
